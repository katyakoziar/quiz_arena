{
  "name": "quiz-arena",
  "version": "1.0.0",
  "description": "Простий аналог Kahoot — вікторина в реальному часі. Node + Express + Socket.io.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "esbuild src_app.jsx --bundle --format=iife --loader:.jsx=jsx --jsx=transform --jsx-factory=React.createElement --jsx-fragment=React.Fragment --target=es2018 --outfile=public/app.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
